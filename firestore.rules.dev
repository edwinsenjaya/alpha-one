rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // TEMPORARY DEVELOPMENT RULES - ALLOW ALL ACCESS
    // ⚠️ WARNING: These rules allow anyone to read/write your database!
    // ⚠️ Only use this temporarily for seeding data during development
    // ⚠️ Remember to restore production rules after seeding!
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

